<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:clipChildren="false"
    android:clipToPadding="false">

    <!-- Timeline Line Top -->
    <View
        android:id="@+id/line_top"
        android:layout_width="2dp"
        android:layout_height="0dp"
        android:background="@color/grey_400"
        app:layout_constraintBottom_toTopOf="@id/module_icon"
        app:layout_constraintEnd_toEndOf="@id/module_icon"
        app:layout_constraintStart_toStartOf="@id/module_icon"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Timeline Line Bottom -->
    <View
        android:id="@+id/line_bottom"
        android:layout_width="2dp"
        android:layout_height="0dp"
        android:background="@color/grey_400"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="@id/module_icon"
        app:layout_constraintStart_toStartOf="@id/module_icon"
        app:layout_constraintTop_toBottomOf="@id/module_icon" />

    <!-- Module Icon on Timeline -->
    <ImageView
        android:id="@+id/module_icon"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_marginStart="16dp"
        android:background="@drawable/circle_background"
        android:backgroundTint="?attr/colorSurface"
        android:padding="6dp"
        android:src="@drawable/ic_module"
        app:tint="@color/module_icon_tint"
        app:layout_constraintBottom_toBottomOf="@id/module_card"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/module_card" />

    <!-- Module Card -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/module_card"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="8dp"
        app:cardBackgroundColor="?attr/colorSurface"
        app:cardCornerRadius="12dp"
        app:cardElevation="2dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/module_icon"
        app:layout_constraintTop_toTopOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="12dp">

            <TextView
                android:id="@+id/module_name"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:textAppearance="?attr/textAppearanceBodyLarge"
                android:textColor="?attr/colorOnSurface"
                android:textStyle="bold"
                app:layout_constraintEnd_toStartOf="@+id/module_enabled_switch"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                tools:text="ToastNotificationModule" />

            <TextView
                android:id="@+id/module_description"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:layout_marginEnd="8dp"
                android:textAppearance="?attr/textAppearanceBodySmall"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:visibility="visible"
                app:layout_constraintEnd_toStartOf="@+id/module_enabled_switch"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/module_name"
                tools:text="Message: Hello World" />

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/module_enabled_switch"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintEnd_toStartOf="@id/drag_handle"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent" />

            <ImageView
                android:id="@+id/drag_handle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:padding="8dp"
                android:src="@drawable/ic_drag_handle"
                app:tint="?attr/colorOnSurfaceVariant"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <!-- Action Buttons (Hidden by default, maybe show on expand?) 
                 For now, let's keep them but maybe adjust visibility or position.
                 The plan says "compactly display". 
                 Let's put them in a row below description if needed, or keep them hidden/accessible via click.
                 The original design had them. Let's keep them but maybe smaller or cleaner.
                 Actually, let's keep the Edit/Run/Delete buttons but maybe only show them when expanded?
                 Or just rely on clicking the card to edit?
                 The adapter has `onEditClicked` on `itemView`.
                 Let's keep `delete_button` and `run_module_button` visible?
                 The user wants "compact".
                 Let's put them below the description.
            -->

            <LinearLayout
                android:id="@+id/actions_layout"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="8dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/module_description">

                <ImageButton
                    android:id="@+id/run_module_button"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Run"
                    android:src="@drawable/ic_play_arrow"
                    android:padding="6dp"
                    app:tint="?attr/colorOnSurfaceVariant" />

                <ImageButton
                    android:id="@+id/delete_button"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_marginStart="8dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Delete"
                    android:src="@drawable/ic_delete"
                    android:padding="6dp"
                    app:tint="?attr/colorOnSurfaceVariant" />
            </LinearLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>
    </com.google.android.material.card.MaterialCardView>

</androidx.constraintlayout.widget.ConstraintLayout>
